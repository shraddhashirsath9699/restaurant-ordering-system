# Copy this file to ".env" and fill in your own values. Never commit .env to Git.

# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/restaurant_db

# Long random text used to sign JWT tokens. Change this!
SECRET_KEY=change-this-to-a-long-random-text

# How long a login token stays valid (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The React app address (allowed by CORS)
FRONTEND_URL=http://localhost:5173
